# Supabase → Project Settings → API. Only these public credentials belong in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Set to your real production origin so social images resolve to absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEVER put Groq/OpenRouter/service-role keys in NEXT_PUBLIC_ variables.
# AI provider keys belong in Supabase Edge Function secrets; see COPILOT_SETUP.md.
